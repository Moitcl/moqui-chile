<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" default-menu-title="Email Messages"
        default-menu-index="70">

    <transition name="emailDetail">
        <default-response url="../EmailDetail"/>
    </transition>

    <transition name="jobRunDetail">
        <default-response url="/qapps/system/ServiceJob/JobRuns/JobRunDetail"/>
    </transition>

    <transition name="envioDetail">
        <default-response url="FindEnvio"/>
    </transition>

    <actions>
        <entity-find entity-name="mchile.dte.EmailMessageProcessingDetail" list="emailList">
            <search-form-inputs default-order-by="-receivedDate,-sentDate"/>
            <select-field field-name="emailMessageId,statusId,sentDate,receivedDate"/>
            <select-field field-name="subject,fromAddress,toAddresses"/>
            <select-field field-name="messageId,emailServerId"/>
            <select-field field-name="jobRunId,envioId,processDate"/>
            <select-field field-name="processingStatusId,processingErrorMessage"/>
        </entity-find>
    </actions>

    <widgets>
        <label text="DTE Email Messages" type="h2"/>

        <form-list name="EmailMessageList" list="emailList" header-dialog="true" saved-finds="true">
            <field name="emailMessageId">
                <header-field title="Email ID" show-order-by="true">
                    <text-find size="20"/>
                </header-field>
                <default-field>
                    <link url="emailDetail" text="${emailMessageId}"
                          parameter-map="[emailMessageId:emailMessageId]" link-type="anchor"/>
                </default-field>
            </field>

            <field name="statusId">
                <header-field title="Email Status" show-order-by="true">
                    <drop-down allow-empty="true">
                        <entity-options>
                            <entity-find entity-name="moqui.basic.StatusItem">
                                <econdition field-name="statusTypeId" value="EmailMessage"/>
                                <order-by field-name="description"/>
                            </entity-find>
                        </entity-options>
                    </drop-down>
                </header-field>
                <default-field>
                    <display-entity entity-name="moqui.basic.StatusItem" text="${description}"/>
                </default-field>
            </field>

            <field name="sentDate">
                <header-field show-order-by="true">
                    <date-period/>
                </header-field>
                <default-field><display format="yyyy-MM-dd HH:mm"/></default-field>
            </field>

            <field name="receivedDate">
                <header-field show-order-by="true">
                    <date-period/>
                </header-field>
                <default-field><display format="yyyy-MM-dd HH:mm"/></default-field>
            </field>

            <field name="fromAddress">
                <header-field><text-find size="30"/></header-field>
                <default-field><display/></default-field>
            </field>

            <field name="toAddresses">
                <header-field><text-find size="30"/></header-field>
                <default-field><display text="${toAddresses?.take(50)}${toAddresses?.length() > 50 ? '...' : ''}"/></default-field>
            </field>

            <field name="subject">
                <header-field><text-find size="40"/></header-field>
                <default-field><display text="${subject?.take(60)}${subject?.length() > 60 ? '...' : ''}"/></default-field>
            </field>

            <field name="messageId">
                <header-field title="Message ID"><text-find size="30"/></header-field>
                <default-field><display text="${messageId?.take(30)}${messageId?.length() > 30 ? '...' : ''}"/></default-field>
            </field>

            <field name="envioId">
                <header-field title="Envio ID"><text-find size="20"/></header-field>
                <default-field>
                    <link url="envioDetail" text="${envioId}"
                          parameter-map="[envioId:envioId]"
                          condition="envioId" link-type="anchor"/>
                    <label text="-" condition="!envioId"/>
                </default-field>
            </field>

            <field name="jobRunId">
                <header-field title="Job Run"><text-find size="20"/></header-field>
                <default-field>
                    <link url="jobRunDetail" text="${jobRunId}"
                          parameter-map="[jobRunId:jobRunId]"
                          condition="jobRunId" link-type="anchor"/>
                    <label text="-" condition="!jobRunId"/>
                </default-field>
            </field>

            <field name="processDate">
                <header-field show-order-by="true"><date-period/></header-field>
                <default-field><display format="yyyy-MM-dd HH:mm" also-hidden="false"/></default-field>
            </field>

            <field name="processingStatusId">
                <header-field title="Processing Status">
                    <drop-down allow-empty="true">
                        <entity-options>
                            <entity-find entity-name="moqui.basic.StatusItem">
                                <econdition field-name="statusTypeId" value="DteEmailProcessing"/>
                                <order-by field-name="description"/>
                            </entity-find>
                        </entity-options>
                    </drop-down>
                </header-field>
                <default-field>
                    <display-entity entity-name="moqui.basic.StatusItem" key-field-name="statusId" text="${description}"/>
                </default-field>
            </field>

            <field name="jobHasError">
                <header-field title="Has Error">
                    <drop-down allow-empty="true">
                        <option key="Y" text="Yes"/>
                        <option key="N" text="No"/>
                    </drop-down>
                </header-field>
                <default-field>
                    <display text="${jobHasError == 'Y' ? 'Error' : (jobHasError == 'N' ? 'OK' : '-')}"/>
                </default-field>
            </field>

            <field name="find"><header-field title="Find"><submit/></header-field></field>

            <form-list-column><field-ref name="emailMessageId"/></form-list-column>
            <form-list-column><field-ref name="statusId"/></form-list-column>
            <form-list-column><field-ref name="sentDate"/><field-ref name="receivedDate"/></form-list-column>
            <form-list-column><field-ref name="fromAddress"/><field-ref name="toAddresses"/></form-list-column>
            <form-list-column><field-ref name="subject"/></form-list-column>
            <form-list-column><field-ref name="messageId"/></form-list-column>
            <form-list-column><field-ref name="envioId"/><field-ref name="processDate"/></form-list-column>
            <form-list-column><field-ref name="jobRunId"/><field-ref name="jobHasError"/></form-list-column>
            <form-list-column><field-ref name="processingStatusId"/></form-list-column>
        </form-list>
    </widgets>
</screen>