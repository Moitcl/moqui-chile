<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Envíos de Respuesta" default-menu-index="1" standalone="true">

    <parameter name="envioId" required="true"/>

    <transition name="downloadEnvio" read-only="true">
        <actions>
            <entity-find-one entity-name="mchile.dte.DteEnvio" value-field="envio"/>
            <script>
                if (envio?.documentLocation)
                    ec.web.sendResourceResponse(envio.documentLocation)
                else
                    ec.message.addError("No se encuentra documento de env�o ${envioId}")
            </script>
        </actions>
        <default-response type="none"/>
    </transition>

    <transition name="findEnvio">
        <default-response url="../FindEnvio" parameter-map="[envioId:envioId]"/>
    </transition>

    <actions>
        <entity-find entity-name="mchile.dte.DteEnvio" list="responseEnvioList">
            <econdition field-name="responseToEnvioId" from="envioId"/>
            <order-by field-name="-registerDate"/>
        </entity-find>
    </actions>

    <widgets>
        <container>
            <label text="Envíos de Respuesta" type="h2"/>

            <form-list name="FindEnvioResponsesForm" list="responseEnvioList" skip-form="true">
                <field name="envioId">
                    <header-field title="ID Envío" show-order-by="true"/>
                    <default-field><link url="../../FindEnvio" text="${envioId}" parameter-map="[envioId:envioId]"/></default-field>
                </field>
                
                <field name="statusId">
                    <header-field title="Estado" show-order-by="true"/>
                    <default-field><display-entity entity-name="moqui.basic.StatusItem"/></default-field>
                </field>
                
                <field name="envioTypeEnumId">
                    <header-field title="Tipo de Envío" show-order-by="true"/>
                    <default-field><display-entity entity-name="moqui.basic.Enumeration"/></default-field>
                </field>
                
                <field name="registerDate">
                    <header-field title="Fecha Registro" show-order-by="true"/>
                    <default-field><display format="yyyy-MM-dd HH:mm"/></default-field>
                </field>
                
                <field name="documentLocation">
                    <header-field title="Documento"/>
                    <default-field>
                        <link url="downloadEnvio" parameter-map="[envioId:envioId]" text="Descargar" link-type="anchor" condition="documentLocation"/>
                    </default-field>
                </field>
                
                <columns>
                    <column><field-ref name="envioId"/></column>
                    <column><field-ref name="statusId"/></column>
                    <column><field-ref name="envioTypeEnumId"/></column>
                    <column><field-ref name="registerDate"/></column>
                    <column><field-ref name="documentLocation"/></column>
                </columns>
            </form-list>
        </container>
    </widgets>

</screen>