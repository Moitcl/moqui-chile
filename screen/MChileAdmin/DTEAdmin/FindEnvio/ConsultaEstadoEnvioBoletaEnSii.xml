<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd" default-menu-include="false">

    <parameter name="envioId" required="true"/>

    <actions>
        <entity-find-one entity-name="mchile.dte.DteEnvio" value-field="envio"/>
        <service-call name="mchile.sii.dte.DteCommServices.verifica#EnvioBoletaEnSii" in-map="[applyResults:false, envioId:envioId]" out-map="envioBoletaResult"/>
    </actions>

    <widgets>
        <label type="h1" text="Envío ${envio?.envioId}"/>
        <label type="h3" text="Track ID: ${envio?.trackId}"/>
        <form-list name="EstadisticasForm" list="envioBoletaResult.estadisticaSii">
            <field name="fiscalTaxDocumentTypeEnumId" from="'Ftdt-'+tipo"><default-field><display-entity entity-name="moqui.basic.Enumeration"/></default-field></field>
            <field name="informados"><default-field><display/></default-field></field>
            <field name="aceptados"><default-field><display/></default-field></field>
            <field name="rechazados"><default-field><display/></default-field></field>
            <field name="reparos"><default-field><display/></default-field></field>
        </form-list>

        <section-iterate name="DetalleReparoRechazo" list="envioBoletaResult.detalleReparoRechazoSii" entry="boleta">
            <actions>
                <entity-find-one entity-name="moqui.basic.Enumeration" value-field="tipoBoleta" auto-field-map="[enumId:'Ftdt-'+boleta.tipo]"/>
            </actions>
            <widgets>
                <container-box id="DetalleReparoRechazoBoleta">
                    <box-header title="${tipoBoleta.description} ${ec.l10n.format(boleta.folio, '#,###')}"/>
                    <box-body>
                        <label text="Estado: ${boleta.estado} (${boleta.descripcion})"/>
                        <form-list name="DetalleBoletaErrores" list="boleta.error">
                            <field name="seccion"><default-field title="Sección"><display/></default-field></field>
                            <field name="linea"><default-field title="Línea"><display/></default-field></field>
                            <field name="nivel"><default-field><display/></default-field></field>
                            <field name="codigo"><default-field title="Código"><display/></default-field></field>
                            <field name="descripcion"><default-field title="Descripción"><display/></default-field></field>
                            <field name="detalle"><default-field><display/></default-field></field>
                        </form-list>
                    </box-body>
                </container-box>
            </widgets>
        </section-iterate>
    </widgets>

</screen>