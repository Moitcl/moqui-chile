    <!-- Main Email Processing Status Items -->
    <moqui.basic.StatusType statusTypeId="DteEmailProcessing" description="DTE Email Processing Status"/>
    
    <!-- Initial States -->
    <moqui.basic.StatusItem statusTypeId="DteEmailProcessing" statusId="DepReceived" statusCode="010" description="Email Received"/>
    <moqui.basic.StatusItem statusTypeId="DteEmailProcessing" statusId="DepQueued" statusCode="020" description="Queued for Processing"/>
    <moqui.basic.StatusItem statusTypeId="DteEmailProcessing" statusId="DepProcessing" statusCode="030" description="Processing"/>

    <!-- Analysis States -->
    <moqui.basic.StatusItem statusTypeId="DteEmailProcessing" statusId="DepAnalyzing" statusCode="040" description="Analyzing Attachments"/>
    <moqui.basic.StatusItem statusTypeId="DteEmailProcessing" statusId="DepEnviosDetected" statusCode="050" description="Envios Detected"/>

    <!-- Error States -->
    <moqui.basic.StatusItem statusTypeId="DteEmailProcessing" statusId="DepError" statusCode="200" description="Processing Error"/>

    <!-- Administrative States -->
    <moqui.basic.StatusItem statusTypeId="DteEmailProcessing" statusId="DepDuplicate" statusCode="310" description="Duplicate Email (Already Processed)"/>

    <!-- Status Flow Transitions for Email Processing -->
    <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="DepReceived" toStatusId="DepQueued" transitionName="Queue"/>
    <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="DepReceived" toStatusId="DepDuplicate" transitionName="Mark Duplicate"/>

    <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="DepQueued" toStatusId="DepProcessing" transitionName="Start Processing"/>

    <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="DepProcessing" toStatusId="DepAnalyzing" transitionName="Analyze"/>
    <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="DepProcessing" toStatusId="DepError" transitionName="Error"/>

    <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="DepAnalyzing" toStatusId="DepEnviosDetected" transitionName="Envios Found"/>
    <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="DepAnalyzing" toStatusId="DepError" transitionName="Analysis Error"/>

    <!-- Recovery transitions -->
    <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="DepError" toStatusId="DepQueued" transitionName="Retry"/>

    <!-- Envio-Level Processing Status Items -->
    <moqui.basic.StatusType statusTypeId="DteEmailProcessingEnvio" description="Individual Envio Processing Status"/>

    <!-- Detection States -->
    <moqui.basic.StatusItem statusTypeId="DteEmailProcessingEnvio" statusId="DepEnvioDetected" statusCode="010" description="Envio Detected in Email"/>
    <moqui.basic.StatusItem statusTypeId="DteEmailProcessingEnvio" statusId="DepEnvioValidated" statusCode="020" description="Envio XML Validated"/>

    <!-- Processing States -->
    <moqui.basic.StatusItem statusTypeId="DteEmailProcessingEnvio" statusId="DepEnvioProcessing" statusCode="030" description="Processing Envio"/>
    <moqui.basic.StatusItem statusTypeId="DteEmailProcessingEnvio" statusId="DepEnvioCreated" statusCode="040" description="DteEnvio Entity Created"/>
    <moqui.basic.StatusItem statusTypeId="DteEmailProcessingEnvio" statusId="DepEnvioLinked" statusCode="050" description="Envio Linked to Email"/>

    <!-- Success States -->
    <moqui.basic.StatusItem statusTypeId="DteEmailProcessingEnvio" statusId="DepEnvioProcessed" statusCode="100" description="Envio Processed Successfully"/>
    <moqui.basic.StatusItem statusTypeId="DteEmailProcessingEnvio" statusId="DepEnvioProcessedWithWarnings" statusCode="110" description="Envio Processed with Warnings"/>

    <!-- Error States -->
    <moqui.basic.StatusItem statusTypeId="DteEmailProcessingEnvio" statusId="DepEnvioError" statusCode="200" description="Envio Processing Error"/>
    <moqui.basic.StatusItem statusTypeId="DteEmailProcessingEnvio" statusId="DepEnvioValidationError" statusCode="210" description="Envio XML Validation Error"/>
    <moqui.basic.StatusItem statusTypeId="DteEmailProcessingEnvio" statusId="DepEnvioParsingError" statusCode="220" description="Envio XML Parsing Error"/>
    <moqui.basic.StatusItem statusTypeId="DteEmailProcessingEnvio" statusId="DepEnvioDuplicate" statusCode="230" description="Duplicate Envio (Already Exists)"/>
    <moqui.basic.StatusItem statusTypeId="DteEmailProcessingEnvio" statusId="DepEnvioBusinessError" statusCode="240" description="Business Logic Error"/>

    <!-- Administrative States -->
    <moqui.basic.StatusItem statusTypeId="DteEmailProcessingEnvio" statusId="DepEnvioIgnored" statusCode="300" description="Envio Ignored (Business Rules)"/>
    <moqui.basic.StatusItem statusTypeId="DteEmailProcessingEnvio" statusId="DepEnvioSkipped" statusCode="310" description="Envio Skipped"/>

    <!-- Status Flow Transitions for Envio Processing -->
    <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="DepEnvioDetected" toStatusId="DepEnvioValidated" transitionName="Validate"/>
    <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="DepEnvioDetected" toStatusId="DepEnvioValidationError" transitionName="Validation Failed"/>

    <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="DepEnvioValidated" toStatusId="DepEnvioProcessing" transitionName="Process"/>
    <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="DepEnvioValidated" toStatusId="DepEnvioIgnored" transitionName="Ignore"/>

    <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="DepEnvioProcessing" toStatusId="DepEnvioCreated" transitionName="Create Entity"/>
