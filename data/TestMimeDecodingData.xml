<?xml version="1.0" encoding="UTF-8"?>
<!--
Test data for MIME filename decoding tests
Includes test users, email servers, and sample DTE data
-->
<entity-facade-xml type="moquichile-test">

    <!-- Test Email Server Configuration -->
    <moqui.basic.email.EmailServer emailServerId="TEST_MIME_SERVER" 
                                   smtpHost="test.example.com" smtpPort="587"
                                   storeHost="test.example.com" storePort="995" storeProtocol="pop3"/>

    <!-- Test Email Messages with MIME Encoded Filenames -->
    <moqui.basic.email.EmailMessage emailMessageId="TEST_MIME_001" emailServerId="TEST_MIME_SERVER"
                                    messageId="mime-test-001@test.example.com"
                                    subject="Test Factura Electrónica"
                                    fromAddress="dte@emisor.cl"
                                    toAddresses="receptor@example.com"/>

    <moqui.basic.email.EmailMessage emailMessageId="TEST_MIME_002" emailServerId="TEST_MIME_SERVER"
                                    messageId="mime-test-002@test.example.com"
                                    subject="Test Boleta con Ñ"
                                    fromAddress="dte@emisor.cl"
                                    toAddresses="receptor@example.com"/>

    <!-- Test Organizations for DTE Processing -->
    <mantle.party.Party partyId="TEST_MIME_EMISOR" partyTypeEnumId="PtyOrganization"/>
    <mantle.party.Organization partyId="TEST_MIME_EMISOR" organizationName="Test MIME Emisor SPA"/>
    <mantle.party.PartyIdentification partyId="TEST_MIME_EMISOR" partyIdTypeEnumId="PtidNationalTaxId" idValue="33333333-3"/>

    <mantle.party.Party partyId="TEST_MIME_RECEPTOR" partyTypeEnumId="PtyOrganization"/>
    <mantle.party.Organization partyId="TEST_MIME_RECEPTOR" organizationName="Test MIME Receptor Ltda"/>
    <!--
    <mantle.party.PartyIdentification partyId="TEST_MIME_RECEPTOR" partyIdTypeEnumId="PtidNationalTaxId" idValue="87654322-2"/>
    -->

    <!-- Test Party Roles -->
    <mantle.party.PartyRole partyId="TEST_MIME_EMISOR" roleTypeId="Vendor"/>
    <mantle.party.PartyRole partyId="TEST_MIME_RECEPTOR" roleTypeId="Customer"/>

    <!-- Test Fiscal Tax Documents -->
    <mchile.dte.FiscalTaxDocument fiscalTaxDocumentId="TEST_MIME_DTE_001" 
                                  fiscalTaxDocumentTypeEnumId="Ftdt-33"
                                  fiscalTaxDocumentNumber="12345"
                                  issuerPartyId="TEST_MIME_EMISOR"
                                  issuerPartyIdTypeEnumId="PtidNationalTaxId"
                                  issuerPartyIdValue="33333333-3"
                                  receiverPartyId="TEST_MIME_RECEPTOR"/>

    <mchile.dte.FiscalTaxDocument fiscalTaxDocumentId="TEST_MIME_DTE_002"
                                  fiscalTaxDocumentTypeEnumId="Ftdt-39" 
                                  fiscalTaxDocumentNumber="67890"
                                  issuerPartyId="TEST_MIME_EMISOR"
                                  issuerPartyIdTypeEnumId="PtidNationalTaxId"
                                  issuerPartyIdValue="33333333-3"
                                  receiverPartyId="TEST_MIME_RECEPTOR"/>

    <!-- Sample CAF data for testing -->
    <mchile.dte.Caf cafId="TEST_MIME_CAF_001"
                    issuerPartyId="TEST_MIME_EMISOR"
                    fiscalTaxDocumentTypeEnumId="Ftdt-33"
                    desde="10000" hasta="19999"
                    fechaAutorizacion="2024-01-01"
                    filename="test_caf_33.xml"/>

    <!-- Test Sample MIME Encoded Filenames for Reference -->
    <!-- These are used in the test specifications -->
    <!--
    UTF-8 Q-Encoding Examples:
    =?UTF-8?Q?Factura_Electr=C3=B3nica_123.xml?= → Factura Electrónica 123.xml
    =?UTF-8?Q?Boleta_Ni=F1a_456.pdf?= → Boleta Niña 456.pdf
    =?UTF-8?Q?Nota_Cr=C3=A9dito_789.xml?= → Nota Crédito 789.xml
    =?UTF-8?Q?Gu=C3=ADa_Despacho_001.xml?= → Guía Despacho 001.xml
    =?UTF-8?Q?=E2=9C=85_DTE_Aprobado_2023.xml?= → ✅ DTE Aprobado 2023.xml
    
    ISO-8859-1 Q-Encoding Examples:
    =?ISO-8859-1?Q?Boleta_Ni=F1a_456.pdf?= → Boleta Niña 456.pdf
    =?ISO-8859-1?Q?Nota_Cr=E9dito_003.xml?= → Nota Crédito 003.xml
    
    Base64 Encoding Examples:
    =?UTF-8?B?ZmFjdHVyYV8xMjMueG1s?= → factura_123.xml
    =?UTF-8?B?Tm90YV9DcsOpZGl0b183ODkueG1s?= → Nota_Crédito_789.xml
    
    Multiple Encoded Words:
    =?UTF-8?Q?Nota_Cr=C3=A9dito?= =?UTF-8?Q?_789.xml?= → Nota Crédito_789.xml
    
    Mixed Content:
    DTE_=?UTF-8?Q?Aprobado_2023?=.xml → DTE_Aprobado_2023.xml
    -->

</entity-facade-xml>