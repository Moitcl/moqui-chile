<?xml version="1.0" encoding="UTF-8"?>
<entity-facade-xml type="moquichile-test">
    <!-- EntityFilter setup for tenant isolation testing -->
    
    <!-- Create test user group for EntityFilter testing -->
    <moqui.security.UserGroup userGroupId="TEST_TENANT_USERS" description="Test users with tenant filtering"/>

    <!-- Assign john.doe to test tenant group for EntityFilter testing -->
    <moqui.security.UserGroupMember userId="EX_JOHN_DOE"
                                     userGroupId="TEST_TENANT_USERS"
                                     fromDate="2024-01-01 00:00:00"/>

    <!-- Create artifact group for RUT-related entities -->
    <moqui.security.ArtifactGroup artifactGroupId="TEST_RUT_SERVICE" description="RUT-related Entity Operations">
        <artifacts artifactTypeEnumId="AT_ENTITY" artifactName="mantle.party.PartyIdentification" inheritAuthz="Y"/>
        <artifacts artifactTypeEnumId="AT_ENTITY" artifactName="mantle.party.Party" inheritAuthz="Y"/>
    </moqui.security.ArtifactGroup>

    <!-- Create authorizations that apply the filters -->
    <moqui.security.ArtifactAuthz artifactAuthzId="TEST_TENANT_SERVICE_AUTHZ"
                                  userGroupId="TEST_TENANT_USERS"
                                  artifactGroupId="TEST_RUT_SERVICE"
                                  authzTypeEnumId="AUTHZT_ALLOW"
                                  authzActionEnumId="AUTHZA_ALL">
        <filters artifactAuthzId="TEST_TENANT_SERVICE_AUTHZ" entityFilterSetId="MANTLE_USER_ORG"/>
    </moqui.security.ArtifactAuthz>

    <!-- Apply entity filters to both service and entity operations -->

</entity-facade-xml>